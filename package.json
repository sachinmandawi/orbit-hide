{
  "name": "orbit-hide",
  "version": "1.0.0",
  "description": "Notion Dark Theme Windows Security Vault",
  "author": "Orbit Hide",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build-exe": "electron-builder --win"
  },
  "build": {
    "appId": "com.orbitlock.app",
    "productName": "Orbit Hide",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "files": [
      "main.js",
      "server.js",
      "picker.ps1",
      "public/**/*",
      "build/**/*",
      "node_modules/**/*",
      "package.json",
      "!dist/**/*",
      "!vault_db.json",
      "!test_picker.js",
      "!test_picker_direct.js",
      "!**/*.log",
      "!**/.git/**"
    ],
    "asar": true
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
